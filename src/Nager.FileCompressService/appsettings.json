{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Quartz": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "FileProcessor": {
    "MaxDegreeOfParallelism": 4, // Defines the maximum number of files processed in parallel
    "AnalyzeOnly": true,
    "SourceDirectory": "C:\\MyImageData",
    "ImageOptimizer": {
      "FileExtensions": [
        ".jpg",
        ".jpeg"
      ],
      "Quality": 80,
      "OutputFormat": "jpeg", //webp or jpeg
      "KeepOriginal": true
    }
  }
}
